{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentakeoff.kentucky-ai.com/protocol/v1/measurement.schema.json",
  "title": "Measurement (draft)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sheet_id": {
      "type": "string",
      "minLength": 1
    },
    "condition_id": {
      "type": "string",
      "minLength": 1
    },
    "measure_role": {
      "enum": [
        "floor_area",
        "deduct",
        "linear",
        "surface_area",
        "count"
      ]
    },
    "verts_norm": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/point"
      },
      "minItems": 1
    },
    "verts_norm_holes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/point"
        }
      }
    },
    "computed": {
      "$ref": "common.schema.json#/$defs/computed"
    },
    "quantity_source": {
      "type": "object",
      "description": "A printed EA quantity whose single vertex locates source text, not an installed item. No automatic OCR or approval is implied.",
      "properties": {
        "kind": { "const": "printed_callout" },
        "unit": { "const": "EA" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "unit", "id", "text", "reference"],
      "additionalProperties": true
    },
    "planting_grid": {
      "type":"object",
      "properties": {
        "source_callout_id":{"type":"string","minLength":1},
        "single_species":{"const":true},
        "spacing_ft":{"type":"number","exclusiveMinimum":0},
        "pattern":{"enum":["square","triangular"]},
        "angle_deg":{"type":"number","minimum":-360,"maximum":360},
        "inset_ft":{"type":"number","minimum":0},
        "offset_x_ft":{"type":"number","minimum":0},
        "offset_y_ft":{"type":"number","minimum":0},
        "origin_norm":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":0,"maximum":1}},
        "reference":{"type":"string","minLength":1}
      },
      "required":["source_callout_id","single_species","spacing_ft","pattern","angle_deg","inset_ft","offset_x_ft","offset_y_ft","origin_norm","reference"],
      "additionalProperties":true,
      "description":"Spacing-based layout comparison on a linked bed. Recompute from current boundary, holes, frame and scale; never add generated positions to printed EA. Single-species extent and source reference are declarations, not authenticated review."
    },
    "source_callout_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "On a floor_area, printed-callout measurement IDs describing this shared planting bed. Geometry is editable coverage in SF; it does not derive or add EA. References must resolve to printed callouts on the same sheet; schema validation alone does not check resolution."
    },
    "height_ft": {
      "type": "number"
    },
    "rise_ft": {
      "type": "number",
      "minimum": 0,
      "description": "Linear runs only: this run's own vertical leg UP in feet, overriding the condition's rise_ft (0 included). Absent means the condition default applies."
    },
    "drop_ft": {
      "type": "number",
      "minimum": 0,
      "description": "Linear runs only: this run's own vertical leg DOWN in feet, overriding the condition's drop_ft (0 included). Absent means the condition default applies."
    },
    "label": {
      "type": "string"
    },
    "curved": {
      "type": "boolean"
    },
    "cuts_shape_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "$ref": "provenance.schema.json"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "author": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "sheet_id",
    "condition_id",
    "measure_role",
    "verts_norm",
    "computed"
  ],
  "additionalProperties": true,
  "allOf": [{
    "if":{"required":["planting_grid"]},
    "then":{"required":["source_callout_ids"],"properties":{"measure_role":{"const":"floor_area"}}}
  }, {
    "if": { "required": ["source_callout_ids"] },
    "then": { "properties": { "measure_role": { "const": "floor_area" } } }
  }, {
    "if": { "required": ["quantity_source"] },
    "then": { "properties": {
      "measure_role": { "const": "count" },
      "verts_norm": { "type": "array", "minItems": 1, "maxItems": 1 },
      "computed": { "type": "object", "required": ["count"], "properties": { "count": { "type": "integer", "minimum": 1 } } }
    } }
  }],
  "description": "One existing shape record. Legacy curved=true means spline control points; new baked arcs use ordinary vertices and origin.curved. Do not conflate or regenerate them."
}
